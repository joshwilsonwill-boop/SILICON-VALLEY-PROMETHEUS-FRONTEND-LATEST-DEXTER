# Prometheus Mini-Runs (long-form → short-form). Server-only — reuse the same
# MODAL_PROXY_KEY / MODAL_PROXY_SECRET as the Modal backend bridge.
# Modal exposes the protected web_server at its LABEL subdomain (`mini-run`), not
# the app-name subdomain; using the wrong host yields `404 modal-http: invalid function call`.
MINI_RUN_BACKEND_URL=https://joshuagreat965--mini-run.modal.run
MINI_RUN_AUTO_DISPATCH=true

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_AVATAR_BUCKET=prometheus-avatars-avatars
R2_PUBLIC_URL=https://cdn.prometheusstudio.tech
